{
  "manifest_version": 3,
  "name": "Luma — Ambient cho YouTube",
  "version": "1.0.0",
  "description": "Ánh sáng theo video, điều khiển kính dễ đọc. Riêng tư, nhẹ và hoàn toàn trên máy của bạn.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Luma · Ambient",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
